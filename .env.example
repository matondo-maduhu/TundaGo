# Neon connection string from Neon dashboard
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Long random admin token. Use same value in admin.html login field.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Webpush integration placeholders: do not activate until official API docs are reviewed
WEBPUSH_API_URL=
WEBPUSH_API_KEY=
WEBPUSH_SECRET=
